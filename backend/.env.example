# Local XAMPP defaults. Copy this file to backend/.env when an override is needed.
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kirana_saarthi
DB_USERNAME=root
DB_PASSWORD=

# Comma-separated exact origins. Localhost/127.0.0.1 on any port are also
# accepted while CORS_ALLOW_LOCALHOST_ANY_PORT=true.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_LOCALHOST_ANY_PORT=true

AUTH_TOKEN_TTL_SECONDS=43200
ADMIN_TOKEN_TTL_SECONDS=3600
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCK_SECONDS=900
